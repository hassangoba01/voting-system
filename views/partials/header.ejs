<% const area = locals.area || 'voter'; const active = locals.active || ''; %>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | <%= electionName %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="area-<%= area %>">
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="<%= area === 'voter' ? '/' : '/admin' %>"><%= electionName %></a>
    <% if (area === 'admin') { %>
      <nav class="nav" aria-label="Admin">
        <a href="/admin" class="<%= active === 'results' ? 'on' : '' %>">Results</a>
        <a href="/admin/positions" class="<%= active === 'positions' ? 'on' : '' %>">Positions</a>
        <a href="/admin/candidates" class="<%= active === 'candidates' ? 'on' : '' %>">Candidates</a>
        <a href="/admin/voters" class="<%= active === 'voters' ? 'on' : '' %>">Voters</a>
      </nav>
      <div class="topbar-right">
        <span class="pill <%= votingOpen ? 'pill-open' : 'pill-closed' %>"><%= votingOpen ? 'Voting open' : 'Voting closed' %></span>
        <form method="post" action="/admin/logout"><button class="btn small ghost-light">Sign out</button></form>
      </div>
    <% } %>
  </div>
</header>
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status"><%= flash.msg %></div>
<% } %>
